{
  "name": "@aeros-core/tokens",
  "version": "2.1.0",
  "description": "Aeros design tokens \u2014 source of truth.",
  "type": "module",
  "main": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "import": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./theme.css": "./dist/css/theme.css",
    "./dart": "./dist/dart/aeros_tokens.dart",
    "./dart-theme": "./dist/dart/aeros_theme_tokens.dart",
    "./source": "./src/tokens.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeros-core/aeros-design-system.git",
    "directory": "packages/tokens"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "dev": "tsx watch src/build.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
